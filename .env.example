# HeistMind environment — copy to .env.local and fill in.
# REQUIRED to run the app: the three NEXT_PUBLIC_SUPABASE_* / SERVICE_ROLE values below.
# Everything else is optional (db type-gen, the future Discord bot, E2E, schema override).

# --- Supabase: app (REQUIRED) ---
NEXT_PUBLIC_SUPABASE_URL=your-project-url          # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key        # public anon key (browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key    # server-only; also mints E2E test sessions

# --- Supabase: tooling (optional) ---
SUPABASE_PROJECT_ID=your-project-id                # needed by `pnpm db:types` (remote type regen).
                                                   # Not needed for `pnpm --filter database db:types-local`.

# Core tables live in an env-named schema (development/production). Default: development.
# NEXT_PUBLIC_HEISTMIND_SCHEMA=development

# Prod holding page: set to 1 (Vercel Production env only) to show a "coming soon" page and block
# sign-in while beta is polished; unset/redeploy to go live. Leave unset everywhere else.
# NEXT_PUBLIC_COMING_SOON=1

# --- Discord bot (optional; the /api/discord interactions endpoint) ---
# The app's Ed25519 PUBLIC key: from the Discord dev portal for a real app, or the key
# `node scripts/discord-post.mjs ping` generates for the tunnel-free local loop.
# Absent → the endpoint answers 503 and everything else is unaffected.
DISCORD_PUBLIC_KEY=your-app-public-key
DISCORD_APP_ID=your-app-id                          # used by command registration (CI)
DISCORD_BOT_TOKEN=your-bot-token                    # used by command registration (CI)
DISCORD_CLIENT_ID=your-client-id                    # web OAuth (Supabase)
DISCORD_CLIENT_SECRET=your-client-secret            # web OAuth (Supabase)

# --- E2E / Playwright (optional; see e2e/README.md) ---
# Where the suite points. Unset → boots a local dev server. Set to a deployed URL to gate it.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# Optional overrides if the E2E Supabase target differs from the app's NEXT_PUBLIC_* vars.
# E2E_SUPABASE_URL=http://127.0.0.1:54321
# E2E_SUPABASE_ANON_KEY=your-local-anon-key
# (SUPABASE_SERVICE_ROLE_KEY above is reused to mint + inject test-user sessions — no Discord needed.)
