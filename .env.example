# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Discord (for bot)
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret

# E2E / Playwright (see e2e/README.md)
# Where the suite points. Unset → boots a local dev server. Set to a deployed URL for the gate.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# Optional overrides if the E2E Supabase target differs from the app's NEXT_PUBLIC_* vars.
# E2E_SUPABASE_URL=http://127.0.0.1:54321
# E2E_SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_ROLE_KEY is reused to mint+inject test-user sessions (no Discord needed).
