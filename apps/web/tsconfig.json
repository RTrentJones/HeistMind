{
  "extends": "../../configs/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@heist-mind/shared/*": ["../../packages/shared/dist/*"],
      "@heist-mind/database/*": ["../../packages/database/dist/*"],
      "@heist-mind/ui/*": ["../../packages/ui/dist/*"]
    },
    "incremental": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["test", ".next", "../../configs", "vitest.config.ts"]
}
