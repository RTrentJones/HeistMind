{
    "name": "@heist-mind/ui",
    "version": "1.0.0",
    "description": "Shared UI components and design system for HeistMind",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./styles": "./dist/styles/globals.css",
        "./tailwind": "./tailwind.config.js"
    },
    "files": [
        "dist",
        "tailwind.config.js"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "clean": "rm -rf dist",
        "type-check": "tsc --noEmit",
        "lint": "eslint src --ext .ts,.tsx"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.0.0",
        "tailwind-merge": "^2.0.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "tailwindcss": ">=3.0.0"
    },
    "keywords": [
        "ui",
        "components",
        "design-system",
        "react",
        "typescript",
        "tailwindcss"
    ]
}