{
  "name": "@heist-mind/telemetry",
  "version": "1.0.0",
  "description": "HeistMind's observability seam: a tiny OpenTelemetry-compatible capture/log API every client calls. Backends (Sentry in web, whatever the bot chooses) plug in behind it — swap the vendor, keep the call sites.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
