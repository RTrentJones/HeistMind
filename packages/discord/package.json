{
  "name": "@heist-mind/discord",
  "version": "1.0.0",
  "license": "MIT",
  "description": "HeistMind's Discord client: Ed25519 request verification, the interaction router, slash-command handlers over the engine, and the command manifest + registration script. The web app's /api/discord route is a thin transport over this package.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "register": "tsx src/registration/register-commands.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@heist-mind/core": "workspace:*",
    "@heist-mind/database": "workspace:^",
    "@heist-mind/engine": "workspace:^",
    "discord-api-types": "^0.37.100"
  },
  "devDependencies": {
    "@heist-mind/shared": "workspace:^",
    "tsx": "^4.23.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
