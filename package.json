{
  "name": "heist-mind",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "build:ui": "turbo build --filter=@heist-mind/ui",
    "build:web": "turbo build --filter=@heist-mind/web",
    "dev:ui": "pnpm --filter=@heist-mind/ui dev",
    "dev:web": "pnpm --filter=@heist-mind/web dev",
    "db:push": "pnpm --filter database db:push",
    "db:types": "pnpm --filter database db:types"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.0"
}